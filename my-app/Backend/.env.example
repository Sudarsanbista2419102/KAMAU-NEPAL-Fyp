# Backend environment variables
# Copy this file to .env and fill in real values

# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/kamau_nepal

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (for OTP)
# For Gmail: Use App Password (16 characters), NOT your regular password
# Steps to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App passwords (at the bottom of Security page)
# 4. Select "Mail" and "Windows Computer" (or your device)
# 5. Copy the 16-character password and paste it below (spaces will be removed automatically)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Payment Gateway (Optional)
KHALTI_SECRET_KEY=your-khalti-secret-key
ESEWA_MERCHANT_ID=your-esewa-merchant-id
